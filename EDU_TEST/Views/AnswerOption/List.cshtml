@model EDU_TEST.Models.Question
@{
    ViewData["Title"] = "Варіанти відповідей";
}

<style>
    .option-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 18px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        border: 1px solid rgba(0,0,0,0.06);
    }

        .option-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08);
        }

    .correct-badge {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: #155724;
        font-weight: 700;
    }
</style>

<div class="container py-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 mb-4">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header border-0 text-white"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a href="/Admin" class="text-white-50 text-decoration-none">Тести</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/Question/List?testId=@Model.TestId" class="text-white-50 text-decoration-none">Питання</a>
                    </li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Варіанти</li>
                </ol>
            </nav>
            <h4 class="mb-0 fw-semibold">Питання: @Model.Text</h4>
        </div>

        <div class="card-body p-4">
            <div class="text-muted small">
                Правильна відповідь у базі (текст): <span class="fw-semibold text-dark">@Model.CorrectAnswer</span>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h5 class="mb-0 fw-semibold">Доступні варіанти</h5>
        <a href="/AnswerOption/Create?questionId=@Model.Id" class="btn btn-primary rounded-pill px-4 shadow-sm">
            + Додати варіант
        </a>
    </div>

    <div class="row g-3">
        @if (Model.Options != null && Model.Options.Any())
        {
            @foreach (var opt in Model.Options)
            {
                bool isCorrect = opt.IsCorrect;

                <div class="col-12 col-md-6">
                    <div class="card option-card h-100 @(isCorrect ? "border border-success" : "")">
                        <div class="card-body p-4 d-flex justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="fs-5">@opt.Text</div>
                                @if (isCorrect)
                                {
                                    <div class="mt-2">
                                        <span class="badge correct-badge rounded-pill px-3 py-2">
                                            ✅ Правильно
                                        </span>
                                    </div>
                                }
                            </div>

                            <div class="d-flex flex-column gap-2">
                                <a href="/AnswerOption/Edit/@opt.Id" class="btn btn-sm btn-outline-warning rounded-pill">
                                    Редагувати
                                </a>

                                <form asp-action="DeleteConfirmed" asp-controller="AnswerOption" method="post"
                                      onsubmit="return confirm('Видалити цей варіант?')">
                                    <input type="hidden" name="id" value="@opt.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100">
                                        Видалити
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-5 text-center text-muted">
                        Варіантів ще не додано.
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a href="/Question/List?testId=@Model.TestId" class="btn btn-outline-secondary rounded-pill px-4">
            ← Назад до питань
        </a>
    </div>
</div>