@model EDU_TEST.Models.Question
@{
    ViewData["Title"] = "Варіанти відповідей";
}

<style>
    .option-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        transition: transform 0.2s;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .option-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .correct-badge {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: #155724;
        font-weight: bold;
    }
</style>

<div class="container mt-5">
    <div class="p-4 mb-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin" class="text-white-50">Тести</a></li>
                <li class="breadcrumb-item"><a href="/Question/List?testId=@Model.TestId" class="text-white-50">Питання</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Варіанти</li>
            </ol>
        </nav>
        <h2 class="fw-bold">Питання: @Model.Text</h2>
        <p class="mb-0 text-white-50">Правильна відповідь у базі: <strong>@Model.CorrectAnswer</strong></p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark">Доступні варіанти</h4>
        <a href="/AnswerOption/Create?questionId=@Model.Id" class="btn btn-success btn-pulse rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Додати варіант
        </a>
    </div>

    <div class="row">
        @if (Model.Options != null && Model.Options.Any())
        {
            @foreach (var opt in Model.Options)
            {
                bool isCorrect = opt.Text == Model.CorrectAnswer;

                <div class="col-md-6 mb-3">
                    <div class="card option-card h-100 @(isCorrect ? "border-success" : "")">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fs-5">@opt.Text</span>
                                @if (isCorrect)
                                {
                                    <span class="badge correct-badge ms-2 rounded-pill px-3">
                                        <i class="fas fa-check me-1"></i> Правильно
                                    </span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/AnswerOption/Edit/@opt.Id" class="btn btn-sm btn-outline-warning rounded-pill">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteConfirmed" asp-controller="AnswerOption" method="post" onsubmit="return confirm('Видалити цей варіант?')">
                                    <input type="hidden" name="id" value="@opt.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fs-4">Варіантів ще не додано.</div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a href="/Question/List?testId=@Model.TestId" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-2"></i>Назад до питань
        </a>
    </div>
</div>