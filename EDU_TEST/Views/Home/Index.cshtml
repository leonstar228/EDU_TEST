@{
    ViewData["Title"] = "Головна";
}

<style>
    body {
        margin: 0;
        overflow-x: hidden;
    }

    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .hero-content {
        flex: 1;
        display: flex;
        align-items: center;
        padding-top: 120px;
        padding-bottom: 60px;
        position: relative;
        z-index: 2;
    }

    .animated-title {
        animation: fadeInDown 1s ease;
        text-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .lead-animated {
        animation: fadeInUp 1.2s ease;
        opacity: 0.95;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-modern {
        border-radius: 25px;
        padding: 45px 35px;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.15);
        color: white;
        transition: 0.4s cubic-bezier(.175,.885,.32,1.275);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .card-modern::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.15), transparent);
            transform: translateX(-100%);
            transition: 0.7s;
        }

        .card-modern:hover::before {
            transform: translateX(100%);
        }

        .card-modern:hover {
            transform: translateY(-15px) scale(1.03);
            box-shadow: 0 35px 60px rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.4);
        }

        .card-modern h4 {
            font-weight: 600;
            margin-bottom: 15px;
        }

        .card-modern p {
            opacity: 0.9;
            margin-bottom: 30px;
        }

    .btn-glow {
        border-radius: 40px;
        padding: 12px 30px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-glow:hover {
            transform: scale(1.08);
            box-shadow: 0 0 20px rgba(255,255,255,0.6);
        }

    .particle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        animation: float 8s infinite ease-in-out;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-25px);
        }
    }

    .p1 {
        width: 120px;
        height: 120px;
        top: 15%;
        left: 5%;
    }

    .p2 {
        width: 80px;
        height: 80px;
        bottom: 20%;
        right: 8%;
        animation-delay: 2s;
    }

    .p3 {
        width: 60px;
        height: 60px;
        top: 40%;
        right: 20%;
        animation-delay: 1s;
    }
</style>

<div class="gradient-bg">


    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>


    <div class="hero-content">
        <div class="container text-center text-white">

            <h1 class="display-3 fw-bold animated-title mb-3">
                <i class="fas fa-graduation-cap me-3"></i>
                Система тестування студентів
            </h1>

            <p class="lead lead-animated mb-5">
                Сучасна платформа для онлайн тестування з інтелектуальною системою оцінювання
            </p>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card-modern">
                        <h4>Авторизація</h4>
                        <p>Увійдіть у свій акаунт для доступу до тестів</p>
                        <a href="/Auth/Login" class="btn btn-primary btn-glow">
                            Увійти
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card-modern">
                        <h4>Реєстрація</h4>
                        <p>Приєднуйтесь до платформи за 1 хвилину</p>
                        <a href="/Auth/Register" class="btn btn-success btn-glow">
                            Зареєструватися
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card-modern">
                        <h4>Про систему</h4>
                        <p>AI • Тести • Статистика</p>
                        <button class="btn btn-secondary btn-glow" disabled>
                            Доступ після входу
                        </button>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">