@model IEnumerable<EDU_TEST.Models.Test>
@{
    ViewData["Title"] = "Мій кабінет";
    var myResults = ViewBag.MyResults as IEnumerable<EDU_TEST.Models.TestResult>;
    var q = (ViewBag.SearchQuery as string) ?? "";
    var activeTab = (ViewBag.ActiveTab as string) ?? "available";
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding-bottom: 80px;
    }

    .wave {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100px;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.2" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,154.7C960,171,1056,181,1152,165.3C1248,149,1344,107,1392,85.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
        background-size: cover;
        z-index: 1;
    }

    .floating-particle {
        position: absolute;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        z-index: 0;
    }

    .particle1 {
        width: 120px;
        height: 120px;
        top: 10%;
        left: -20px;
    }

    .particle2 {
        width: 80px;
        height: 80px;
        bottom: 30%;
        right: 5%;
    }

    .text-center h1.animated-title {
        color: #ffffff !important;
        text-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .lead-animated {
        color: rgba(255,255,255,0.95) !important;
        font-weight: 300;
    }

    .card {
        border: none !important;
        background: #ffffff !important;
        border-radius: 24px !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        z-index: 2;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.2) !important;
        }

        .card h4, .card h5 {
            color: #2d3436 !important;
            margin-top: 10px;
        }

        .card .text-muted {
            color: #636e72 !important;
        }

    .card-icon {
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        margin-bottom: 15px;
    }

    #studentTabs {
        background: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

        #studentTabs .nav-link {
            color: #ffffff !important;
            border: none;
            padding: 12px 25px;
        }

            #studentTabs .nav-link.active {
                background: #ffffff !important;
                color: #764ba2 !important;
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

    .btn-primary.btn-pulse {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border: none !important;
        padding: 12px;
    }

    .btn-outline-secondary {
        border: 2px solid #764ba2 !important;
        color: #764ba2 !important;
        font-weight: 600;
    }

        .btn-outline-secondary:hover {
            background: #764ba2 !important;
            color: #fff !important;
        }

    .badge {
        padding: 8px 16px !important;
        font-size: 0.9rem !important;
    }
</style>

<div class="gradient-bg">
    <div class="wave"></div>
    <div class="floating-particle particle1"></div>
    <div class="floating-particle particle2"></div>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold animated-title text-white">Привіт, @User.Identity.Name! 👋</h1>
            <p class="lead-animated">Оберіть тест для перевірки знань або перегляньте свою історію успіхів.</p>
        </div>

        <ul class="nav nav-pills nav-justified mb-5 shadow-sm rounded-pill p-1 bg-light" id="studentTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold @(activeTab == "available" ? "active" : "")"
                        id="available-tab" data-bs-toggle="tab" data-bs-target="#available" type="button">
                    🚀 Доступні тести
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold @(activeTab == "myresults" ? "active" : "")"
                        id="my-results-tab" data-bs-toggle="tab" data-bs-target="#myresults" type="button">
                    🏆 Мої результати
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade @(activeTab == "available" ? "show active" : "")" id="available">
                <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 20px;">
                    <form method="get" asp-controller="Student" asp-action="Index" class="row g-2 align-items-center">
                        <input type="hidden" name="tab" value="available" />
                        <div class="col-md-8">
                            <input name="q" value="@q" class="form-control form-control-lg rounded-pill"
                                   placeholder="Пошук тестів за назвою..." />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-primary btn-pulse rounded-pill fw-bold" type="submit">Знайти</button>
                        </div>
                        <div class="col-md-2 d-grid">
                            <a class="btn btn-outline-secondary rounded-pill fw-bold"
                               asp-controller="Student" asp-action="Index" asp-route-tab="available">
                                Скинути
                            </a>
                        </div>
                    </form>
                </div>

                <div class="row">
                    @foreach (var test in Model)
                    {
                        <div class="col-md-4 mb-4 card-wrapper">
                            <div class="card h-100 shadow-sm border-0 text-center p-4">
                                <div class="card-icon mb-3">
                                    <i class="bi bi-book"></i>
                                </div>
                                <h4 class="animated-title fw-bold mb-3">@test.Title</h4>
                                <p class="text-muted small flex-grow-1">@(test.Questions?.Count ?? 0) питань</p>
                                <a asp-controller="TestPassing" asp-action="Start" asp-route-testId="@test.Id"
                                   class="btn btn-primary btn-pulse w-100 rounded-pill py-2 fw-bold shadow-sm">
                                    Почати тест
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center text-white mt-3">
                        Нічого не знайдено.
                    </div>
                }
            </div>

            <div class="tab-pane fade @(activeTab == "myresults" ? "show active" : "")" id="myresults">
                <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                    @if (myResults == null || !myResults.Any())
                    {
                        <div class="text-center py-5">
                            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="mb-3 opacity-50" alt="no data">
                            <p class="text-muted">Ви ще не пройшли жодного тесту. Ваші майбутні оцінки з'являться тут!</p>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var res in myResults.Take(5))
                            {
                                <div class="col-md-6 mb-4 card-wrapper">
                                    <div class="card p-4">
                                        <h5 class="fw-bold">@res.Test?.Title</h5>
                                        <p class="text-muted">@res.DateTaken.ToString("dd.MM.yyyy")</p>
                                        <span class="badge @(res.Score >= 60 ? "bg-success" : "bg-danger") rounded-pill px-3">
                                            @res.Score %
                                        </span>
                                        <div class="mt-3">
                                            <a asp-action="ResultSummary" asp-route-testId="@res.TestId"
                                               class="btn btn-outline-secondary btn-pulse rounded-pill">
                                                Деталі
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a class="btn btn-link text-decoration-none"
                               asp-controller="Student" asp-action="Index" asp-route-tab="myresults">
                                Переглянути всі результати
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>