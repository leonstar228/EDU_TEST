@model EDU_TEST.Models.TestResult
@{
    ViewData["Title"] = "Підсумок результату";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header border-0 text-white"
                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                        <div>
                            <h3 class="mb-1 fw-bold">Результат тесту</h3>
                            <div class="text-white-50">@Model.Test?.Title</div>
                        </div>
                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                            @Model.Score%
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 bg-light h-100">
                                <div class="text-muted small mb-1">Дата проходження</div>
                                <div class="fw-semibold">@Model.DateTaken.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-4 rounded-4 bg-light h-100">
                                <div class="text-muted small mb-1">Статус</div>
                                <div class="fw-semibold @(Model.Score >= 60 ? "text-success" : "text-danger")">
                                    @(Model.Score >= 60 ? "Складено ✅" : "Не складено ❌")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <h5 class="mb-0 fw-semibold">Питання та правильні відповіді</h5>
                        <span class="text-muted small">Показуємо правильні варіанти з бази</span>
                    </div>

                    @if (Model.Test?.Questions == null || !Model.Test.Questions.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-4 mb-0">
                            У цьому тесті немає питань або дані не завантажились.
                        </div>
                    }
                    else
                    {
                        <div class="vstack gap-3">
                            @foreach (var q in Model.Test.Questions)
                            {
                                var correctOption = q.Options?.FirstOrDefault(o => o.IsCorrect);

                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-body p-4">
                                        <div class="fw-semibold mb-2">@q.Text</div>

                                        @if (correctOption != null)
                                        {
                                            <div class="p-3 rounded-4 bg-success-subtle">
                                                <span class="fw-semibold text-success">Правильна відповідь:</span>
                                                <span class="text-dark">@correctOption.Text</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 rounded-4 bg-warning-subtle">
                                                <span class="fw-semibold text-warning">Увага:</span>
                                                <span class="text-dark">Правильну відповідь не задано</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a asp-action="MyResults" class="btn btn-outline-secondary rounded-pill px-4">
                            ← До моїх результатів
                        </a>
                        <a asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            До кабінету
                        </a>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 px-4 px-md-5 pb-4">
                    <div class="text-muted small">
                        Якщо хочеш — додамо відображення саме твоїх відповідей/помилок (потрібно зберігати відповіді по питаннях).
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>