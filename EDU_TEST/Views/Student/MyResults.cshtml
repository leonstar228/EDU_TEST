@model IEnumerable<EDU_TEST.Models.TestResult>
@{
    ViewData["Title"] = "Мої результати";
}

<div class="container py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h2 class="mb-1 fw-bold">📚 Мої результати</h2>
            <div class="text-muted">Історія проходження тестів і підсумкові бали</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
            До списку тестів
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="display-6 mb-2">😌</div>
                <h4 class="fw-semibold mb-2">Ви ще не пройшли жодного тесту</h4>
                <p class="text-muted mb-4">Оберіть тест зі списку та перевірте свої знання.</p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    Обрати тест
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var res in Model)
            {
                var isPass = res.Score >= 60;

                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex align-items-start justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <h5 class="mb-1 fw-semibold">@res.Test?.Title</h5>
                                <div class="text-muted small">
                                    📅 @res.DateTaken.ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </div>

                            <div class="text-end">
                                <div class="h2 fw-bold mb-0 @(isPass ? "text-success" : "text-danger")">
                                    @res.Score%
                                </div>
                                <a asp-action="ResultSummary"
                                   asp-route-testId="@res.TestId"
                                   class="btn btn-link p-0 text-decoration-none">
                                    Переглянути правильні відповіді →
                                </a>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                            <span class="badge rounded-pill px-3 py-2 @(isPass ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                @(isPass ? "Тест складено" : "Тест не складено")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>