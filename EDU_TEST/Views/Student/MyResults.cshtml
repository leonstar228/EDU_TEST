@model IEnumerable<EDU_TEST.Models.TestResult>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📚 Мої досягнення</h2>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill">До списку тестів</a>
    </div>

    @if (!Model.Any())
    {
                <div class="alert alert-info text-center p-5 shadow-sm">
                    <h4>Ви ще не пройшли жодного тесту.</h4>
                    <p>Час перевірити свої знання!</p>
                    <a asp-action="Index" class="btn btn-primary mt-3">Обрати тест</a>
                </div>
    }
    else
    {
                <div class="row">
            @foreach (var res in Model)
            {
                                <div class="col-md-6 mb-4">
                                    <div class="card h-100 shadow-sm border-0" style="border-radius: 15px;">
                                        <div class="card-body d-flex justify-content-between align-items-center p-4">
                                            <div>
                                                <h5 class="card-title fw-bold mb-1">@res.Test?.Title</h5>
                                                <p class="text-muted small mb-0">
                                                    📅 @res.DateTaken.ToString("dd.MM.yyyy HH:mm")
                                                </p>
                                            </div>
                                            <div class="text-end">
                                                <div class="h2 fw-bold mb-0 @(res.Score >= 60 ? "text-success" : "text-danger")">
                                    @res.Score%
                                                </div>
                                                <a asp-action="ResultSummary" asp-route-testId="@res.TestId" class="btn btn-sm btn-link text-decoration-none p-0">
                                                    Переглянути помилки →
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
            }
                </div>
    }
</div>