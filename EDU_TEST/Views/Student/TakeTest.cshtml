@model EDU_TEST.Models.Test

<style>
    /* Картка прев'ю */
    .test-preview-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(15px);
        border-radius: 30px;
        max-width: 700px;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.3);
        z-index: 2;
    }

    /* Великий заголовок */
    .test-preview-card h1 {
        color: #2d3436;
        font-size: 2.5rem;
    }

    /* Декоративна лінія */
    .divider {
        width: 60px;
        height: 5px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 10px;
    }

    /* Іконка зверху */
    .preview-icon {
        font-size: 3rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    /* Кнопки */
    .btn-primary-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .btn-primary-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
        color: white;
    }

    .btn-outline-custom {
        border: 2px solid #667eea;
        color: #667eea;
        background: transparent;
        transition: all 0.3s;
    }

    .btn-outline-custom:hover {
        background: #667eea;
        color: white;
    }

    /* Текст опису */
    .text-secondary {
        color: #636e72 !important;
        line-height: 1.6;
    }
</style>
<div class="gradient-bg">
    <div class="wave"></div>
    <div class="floating-particle particle1"></div>
    <div class="floating-particle particle2"></div>

    <div class="container d-flex align-items-center justify-content-center" style="min-height: 90vh;">
        <div class="test-preview-card text-center p-5 shadow-lg">
            <div class="preview-icon mb-4">
                <i class="bi bi-rocket-takeoff"></i>
            </div>

            <h1 class="display-4 fw-bold mb-3">@Model.Title</h1>

            <div class="divider mx-auto mb-4"></div>

            <p class="lead mb-5 text-secondary">
                Ви готові перевірити свої знання? <br>
                Натисніть кнопку нижче, щоб розпочати тест. Успіхів! 🚀
            </p>

            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                <a asp-action="Index" class="btn btn-outline-custom rounded-pill px-5 py-3">
                    Назад
                </a>
                <a asp-action="Start" asp-controller="TestPassing" asp-route-testId="@Model.Id" 
                   class="btn btn-primary-custom rounded-pill px-5 py-3 fw-bold shadow">
                    Почати тест
                </a>
            </div>
        </div>
    </div>
</div>
