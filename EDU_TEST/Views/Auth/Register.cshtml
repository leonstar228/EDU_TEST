@model EDU_TEST.ViewModels.RegisterViewModel
@{
    Layout = "_Layout";
}

<style>
    .auth-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        overflow-y: auto;
        padding: 20px 0;
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        width: 90%;
        max-width: 550px;
        padding: 40px;
        animation: slideUp 0.6s ease-out;
    }

    .btn-register {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        border: none;
        color: #155724;
        font-weight: 800;
        padding: 14px;
        border-radius: 12px;
        transition: 0.3s;
    }

        .btn-register:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(56, 249, 215, 0.4);
        }

    .form-control {
        border-radius: 10px;
        padding: 12px;
        border: 1px solid #ddd;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #4b306a;">Реєстрація</h2>
            <p class="text-muted">Створіть акаунт для початку тестування</p>
        </div>

        <form asp-action="Register" asp-controller="Auth" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ім'я</label>
                    <input type="text" name="FirstName" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Прізвище</label>
                    <input type="text" name="LastName" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="Email" class="form-control" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Пароль</label>
                    <input type="password" name="Password" class="form-control" required />
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Підтвердження</label>
                    <input type="password" name="ConfirmPassword" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn btn-register w-100 mb-3 shadow">
                <i class="fas fa-user-plus me-2"></i> ЗАРЕЄСТРУВАТИСЯ
            </button>

            <div class="text-center">
                <a href="/Auth/Login" class="text-decoration-none fw-bold" style="color: #764ba2;">Вже є акаунт? Увійти</a>
            </div>
        </form>
    </div>
</div>