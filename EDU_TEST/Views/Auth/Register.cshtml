@model EDU_TEST.ViewModels.RegisterViewModel
@{
    Layout = "_Layout";
}

<style>
    .auth-wrapper {
        position: fixed;
        inset: 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 20px 0;
        z-index: 1000;
    }

    .particle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        animation: float 8s infinite ease-in-out;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-30px);
        }
    }

    .p1 {
        width: 140px;
        height: 140px;
        top: 10%;
        left: 8%;
    }

    .p2 {
        width: 90px;
        height: 90px;
        bottom: 15%;
        right: 10%;
        animation-delay: 2s;
    }

    .p3 {
        width: 70px;
        height: 70px;
        top: 40%;
        right: 25%;
        animation-delay: 1s;
    }

    .p4 {
        width: 50px;
        height: 50px;
        bottom: 30%;
        left: 20%;
        animation-delay: 3s;
    }

    .auth-card {
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(15px);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        width: 90%;
        max-width: 540px;
        padding: 40px;
        position: relative;
        z-index: 2;
        animation: slideUp 0.6s ease;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(35px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .btn-register {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        border: none;
        font-weight: 800;
        padding: 14px;
        border-radius: 12px;
        transition: 0.3s;
    }

        .btn-register:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(56,249,215,0.4);
        }

    .form-control {
        border-radius: 10px;
        padding: 12px;
    }
</style>

<div class="auth-wrapper">

    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>

    <div class="auth-card">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Реєстрація</h2>
            <p class="text-muted">Створіть акаунт для початку тестування</p>
        </div>

        <form asp-action="Register" asp-controller="Auth" method="post">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Імʼя</label>
                    <input name="FirstName" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Прізвище</label>
                    <input name="LastName" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Email</label>
                <input type="email" name="Email" class="form-control" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Пароль</label>
                    <input type="password" name="Password" class="form-control" required />
                </div>
                <div class="col-md-6 mb-4">
                    <label class="fw-bold">Підтвердження</label>
                    <input type="password" name="ConfirmPassword" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn btn-register w-100 mb-3 shadow">
                Зареєструватися
            </button>

            <a href="/" class="btn btn-outline-secondary w-100 mb-3">
                ← На головну
            </a>

            <div class="text-center">
                <a href="/Auth/Login" class="fw-bold text-decoration-none">
                    Вже є акаунт? Увійти
                </a>
            </div>

        </form>
    </div>
</div>