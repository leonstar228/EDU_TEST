@model EDU_TEST.Models.Test

<h2>@Model.Title</h2>

<form method="post" asp-action="Submit">

    <input type="hidden" name="TestId" value="@Model.Id" />
    <input type="hidden" name="StudentId" value="@User.FindFirst("Id").Value" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var q = Model.Questions.ElementAt(i);

        <div class="question-block">
            <h4>@(i + 1). @q.Text</h4>

            @foreach (var option in q.Options)
            {
                <label style="display:block; margin-left:15px;">
                    <input type="radio"
                           name="Answers[@i].SelectedAnswerId"
                           value="@option.Id"
                           required />
                    @option.Text
                </label>
            }

            <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
        </div>

        <hr />
    }

    <button type="submit" class="btn btn-primary">Завершити тест</button>
</form>