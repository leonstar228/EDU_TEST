@model EDU_TEST.Models.Question

<style>
    /* Фон сторінки для фокусу */
    body {
        background: #f0f2f5;
    }

    /* Картка питання */
    .card {
        border-radius: 24px !important;
        background: #ffffff !important;
        border: none !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05) !important;
    }

    /* Прогрес-бар з градієнтом */
    .progress {
        background-color: #edf2f7 !important;
        overflow: hidden;
    }

    .progress-bar {
        background: linear-gradient(90deg, #667eea, #764ba2) !important;
        transition: width 0.8s cubic-bezier(0.65, 0, 0.35, 1) !important;
    }

    /* Стилізація варіантів відповідей */
    .option-label {
        border: 2px solid #edf2f7 !important;
        border-radius: 16px !important;
        padding: 18px !important;
        transition: all 0.2s ease-in-out !important;
        background-color: #ffffff;
    }

    .option-label:hover {
        border-color: #667eea !important;
        background-color: rgba(102, 126, 234, 0.02) !important;
        transform: translateY(-2px);
    }

    /* Стан вибраної відповіді */
    .option-label.border-primary {
        border-color: #667eea !important;
        background-color: rgba(102, 126, 234, 0.05) !important;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15) !important;
    }

    /* Приховуємо стандартний radio, робимо кастомний акцент */
    .form-check-input {
        width: 1.3em;
        height: 1.3em;
        margin-top: 0;
        cursor: pointer;
        border: 2px solid #cbd5e0;
    }

    .form-check-input:checked {
        background-color: #667eea !important;
        border-color: #667eea !important;
    }

    /* Кнопки */
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border: none !important;
        padding: 14px !important;
        font-weight: 600 !important;
    }

    .btn-success {
        background: #27ae60 !important;
        border: none !important;
        padding: 14px !important;
    }

    .btn-secondary {
        background: #e2e8f0 !important;
        color: #718096 !important;
        border: none !important;
    }

    /* Алерти (правильно/неправильно) */
    .alert {
        border: none !important;
    }

    .alert-success {
        background-color: #d1fae5 !important;
        color: #065f46 !important;
    }

    .alert-danger {
        background-color: #fee2e2 !important;
        color: #991b1b !important;
    }

    /* Текст питання */
    h3.fw-bold {
        color: #2d3748;
        line-height: 1.4;
    }

    .badge.bg-primary {
        background-color: #764ba2 !important;
    }
</style>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 p-4" style="border-radius: 20px;">

                @* 1. Прогрес-бар *@
                <div class="progress mb-4" style="height: 10px; border-radius: 5px;">
                    @{
                        var total = (int)ViewBag.TotalQuestions;
                        var current = (int)ViewBag.QuestionIndex + 1;
                        var progress = ((double)current / total) * 100;
                    }
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                         role="progressbar" style="width: @progress%"></div>
                </div>

                @* 2. Заголовок питання *@
                <h3 class="fw-bold mb-4 text-center">@Model.Text</h3>

                @* 3. Стан після відповіді (результат) *@
                @if (TempData["LastAnswerCorrect"] != null)
                {
                    bool isCorrect = (bool)TempData["LastAnswerCorrect"];

                            <div class="alert @(isCorrect ? "alert-success" : "alert-danger") shadow-sm d-flex align-items-center mb-4 border-0 animate__animated animate__fadeIn" role="alert" style="border-radius: 15px;">
                                <span class="fs-1 me-3">@(isCorrect ? "✅" : "❌")</span>
                                <div>
                                    <h4 class="alert-heading mb-1 fw-bold">@(isCorrect ? "Правильно!" : "Неправильно!")</h4>
                                    <p class="mb-0 text-dark">Натисніть кнопку нижче, щоб перейти до наступного кроку.</p>
                                </div>
                            </div>

                               <div class="d-grid mt-4">
        <a asp-action="Start" 
           asp-controller="TestPassing" 
           asp-route-testId="@Model.TestId" 
           asp-route-questionIndex="@((int)ViewBag.QuestionIndex + 1)" 
           asp-route-handler="next" 
           class="btn btn-success btn-lg rounded-pill shadow">
            Наступне питання &rarr;
        </a>
    </div>
                }
                else
                {
                    @* 4. Форма вибору відповіді *@
                            <form method="post" asp-action="SubmitAnswer" id="quizForm">
                                <input type="hidden" name="QuestionId" value="@Model.Id" />
                                <input type="hidden" name="TestId" value="@Model.TestId" />
                                <input type="hidden" name="QuestionIndex" value="@ViewBag.QuestionIndex" />

                                <div class="list-group mb-4" id="optionsGroup">
                            @foreach (var option in Model.Options)
                            {
                                                <label class="list-group-item list-group-item-action border rounded-3 mb-3 p-3 d-flex align-items-center shadow-sm option-label" style="transition: 0.2s; cursor: pointer;">
                                                    <input type="radio" name="SelectedAnswerId" value="@option.Id" class="form-check-input me-3" required />
                                                    <span class="fs-5 text-dark">@option.Text</span>
                                                </label>
                            }
                                </div>

                                <div class="d-grid">
                                    <button type="submit" id="submitBtn" class="btn btn-secondary btn-lg rounded-pill shadow-sm" disabled>
                                        Оберіть варіант
                                    </button>
                                </div>
                            </form>
                }

                @* 5. Виправлений підвал з прогресом *@
                <div class="mt-4 border-top pt-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">ID Питання: #@Model.Id</span>
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        @(ViewBag.QuestionIndex + 1) / @ViewBag.TotalQuestions
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
            <script>
                document.addEventListener("DOMContentLoaded", function() {

                    // Логіка вибору варіантів та активації кнопки
                    const form = document.getElementById('quizForm');
                    if(form) {
                        const radioButtons = form.querySelectorAll('input[name="SelectedAnswerId"]');
                        const submitBtn = document.getElementById('submitBtn');
                        const labels = document.querySelectorAll('.option-label');

                        radioButtons.forEach(radio => {
                            radio.addEventListener('change', () => {
                                submitBtn.disabled = false;
                                submitBtn.innerText = "Перевірити відповідь";
                                submitBtn.classList.replace('btn-secondary', 'btn-primary');

                                // Візуальне підсвічування
                                labels.forEach(l => {
                                    l.classList.remove('border-primary', 'bg-light');
                                    l.style.transform = "scale(1)";
                                });
                                const targetLabel = radio.closest('.option-label');
                                targetLabel.classList.add('border-primary', 'bg-light');
                                targetLabel.style.transform = "scale(1.01)";
                            });
                        });
                    }

                    // ЗАХИСТ ВІД КНОПКИ "НАЗАД"
                    history.pushState(null, null, location.href);
                    window.onpopstate = function () {
                        history.go(1);
                    };
                });
            </script>
}