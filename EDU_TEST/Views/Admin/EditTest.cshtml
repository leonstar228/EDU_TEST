@model EDU_TEST.Models.Test
@{
    ViewData["Title"] = "Редагувати тест";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header border-0 rounded-top-4"
                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <h4 class="mb-0 fw-semibold text-white">Редагувати тест</h4>
                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">ID: #@Model.Id</span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger small mb-4">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="EditTest" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Назва тесту</label>
                            <input asp-for="Title" class="form-control form-control-lg" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm">
                                Зберегти
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                                Назад
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-transparent border-0 px-4 px-md-5 pb-4">
                    <div class="text-muted small">
                        Зміни застосуються одразу після збереження.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}