@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header border-0 rounded-top-4 text-white bg-danger">
                    <div class="d-flex align-items-center justify-content-between">
                        <h4 class="mb-0 fw-semibold">Сталася помилка</h4>
                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">Error</span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex gap-3 align-items-start mb-4">
                        <div class="fs-1">🧯</div>
                        <div>
                            <div class="fw-semibold mb-1">Не вдалося обробити запит.</div>
                            <div class="text-muted">
                                Спробуйте оновити сторінку або повернутись назад.
                            </div>
                        </div>
                    </div>

                    @if (Model.ShowRequestId)
                    {
                        <div class="p-3 rounded-4 bg-light">
                            <div class="text-muted small mb-1">Request ID</div>
                            <div class="fw-semibold">@Model.RequestId</div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            На головну
                        </a>
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="history.back()">
                            Назад
                        </button>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 px-4 px-md-5 pb-4">
                    <div class="text-muted small">
                        Якщо помилка повторюється — перевір лог у консолі/Output та деталі винятку.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>