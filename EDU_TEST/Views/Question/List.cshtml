@model EDU_TEST.Models.Test
@{
    ViewData["Title"] = "Питання тесту";
}

<style>
    .question-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        transition: transform 0.3s;
        border-left: 5px solid #667eea;
    }

        .question-card:hover {
            transform: scale(1.01);
        }

    .badge-correct {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: #155724;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 text-white">
        <div>
            <h2 class="fw-bold mb-0" style="color: #4b306a;">Питання до тесту: @Model.Title</h2>
            <p class="text-muted">Керуйте питаннями та варіантами відповідей</p>
        </div>
        <a href="/Question/Create?testId=@Model.Id" class="btn btn-success btn-pulse rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Додати нове питання
        </a>
    </div>

    @if (!Model.Questions.Any())
    {
        <div class="alert alert-info rounded-pill text-center shadow-sm">
            У цьому тесті ще немає питань. Створіть перше!
        </div>
    }
    else
    {
        @foreach (var q in Model.Questions)
        {
            <div class="card question-card shadow-sm mb-4 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="fw-bold text-dark mb-2">@q.Text</h5>
                            <div class="mb-3">
                                <span class="badge badge-correct px-3 py-2 rounded-pill">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Правильна відповідь: <strong>@q.CorrectAnswer</strong>
                                </span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/AnswerOption/List?questionId=@q.Id" class="btn btn-info text-white btn-sm rounded-pill px-3 shadow-sm">
                                <i class="fas fa-list-ul me-1"></i> Варіанти
                            </a>

                            <a href="/Question/Edit/@q.Id" class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm">
                                <i class="fas fa-edit me-1"></i>
                            </a>

                            <form asp-action="DeleteConfirmed" asp-controller="Question" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@q.Id" />
                                <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm"
                                        onclick="return confirm('Ви впевнені, що хочете видалити це питання?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <div class="mt-4">
        <a href="/Admin" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-2"></i>Назад до тестів
        </a>
    </div>
</div>