@model EDU_TEST.Models.Question
@{
    ViewData["Title"] = "Створити питання";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header border-0 text-white"
                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                        <h4 class="mb-0 fw-semibold">Створити питання</h4>
                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">Question</span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small mb-4">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Текст питання</label>
                            <textarea asp-for="Text" class="form-control" rows="3" placeholder="Введіть текст питання..."></textarea>
                            <span asp-validation-for="Text" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Правильна відповідь (текст)</label>
                            <input asp-for="CorrectAnswer" class="form-control" placeholder="Наприклад: 42" />
                            <span asp-validation-for="CorrectAnswer" class="text-danger small"></span>
                            <div class="form-text">
                                Якщо ви використовуєте варіанти відповідей (AnswerOption), правильність задавайте там.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Тест</label>
                            <select asp-for="TestId" class="form-select" asp-items="ViewBag.Tests">
                                <option value="">-- Оберіть тест --</option>
                            </select>
                            <span asp-validation-for="TestId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                Створити
                            </button>

                            <a asp-action="List" asp-route-testId="@Model.TestId" class="btn btn-outline-secondary rounded-pill px-4">
                                Скасувати
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-transparent border-0 px-4 px-md-5 pb-4">
                    <div class="text-muted small">
                        Після створення питання додайте варіанти відповідей і позначте 1 правильний.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}